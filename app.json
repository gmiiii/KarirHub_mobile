{
  "expo": {
    "name": "KarirHub",
    "slug": "karirhub-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "karirhub",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2563eb",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karirhub.mobile"
    },
    "android": {
      "package": "com.karirhub.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan KarirHub mengakses foto untuk mengunggah foto wajah ke pembuat CV."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
